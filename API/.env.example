# Copy to .env and adjust. .env is git-ignored.

# "development" or "production". In production SECRET_KEY becomes mandatory
# and the session cookie is marked Secure.
FLASK_ENV=development

# Never enable in production: the Werkzeug debugger is remote code execution.
FLASK_DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Left empty in development a random key is used, so sessions reset on restart.
SECRET_KEY=

# Absolute or relative to the API directory.
DATABASE_PATH=database.db

# Session lifetime in seconds (default 12 hours).
JWT_TTL_SECONDS=43200

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Brute-force protection.
LOGIN_RATE_LIMIT=5 per minute
REGISTER_RATE_LIMIT=10 per hour
